rules_version = '2';
// ClassroomSim security rules (Spark plan, no server code).
// Mirrored in src/store-memory.js -> allowed(), which the automated tests run against.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function sessionPath(code) { return /databases/$(db)/documents/sessions/$(code); }
    function isStaff(code) { return signedIn() && exists(/databases/$(db)/documents/sessions/$(code)/staff/$(me())); }
    function ownerAfter(code) { return getAfter(sessionPath(code)).data.ownerUid == me(); }
    function onlyChanged(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }
    function isOwner(code) { return signedIn() && get(sessionPath(code)).data.ownerUid == me(); }
    function smallMap(m) { return m is map && m.size() <= 60; }
    // Participants are locked out after participantsUntil (Google's server clock). Evaluators never are.
    function participantsOpen(code) { return request.time.toMillis() < get(sessionPath(code)).data.get('participantsUntil', 8640000000000000); }
    // Optional course-wide passcode for starting sessions: create config/access { startCode: "..." } in the console.
    function startAllowed(code) {
      return !exists(/databases/$(db)/documents/config/access)
        || getAfter(/databases/$(db)/documents/sessions/$(code)/proof/$(me())).data.key
           == get(/databases/$(db)/documents/config/access).data.startCode;
    }

    // Course admin (super admin): reads every session, edits grading rules and course cards, overrides outcomes. Turned on by creating
    // config/admin { code: "a long passcode" } in the console. Changing that code signs every admin out.
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(db)/documents/admins/$(me()))
        && exists(/databases/$(db)/documents/config/admin)
        && get(/databases/$(db)/documents/admins/$(me())).data.key == get(/databases/$(db)/documents/config/admin).data.code;
    }

    // Course settings: never readable or writable from the app (edit them in the Firebase console)
    match /config/{doc} { allow read, write: if false; }

    // Proof of the admin passcode. Only accepted when it matches config/admin.code.
    match /admins/{uid} {
      allow get, delete: if signedIn() && uid == me();
      allow create, update: if signedIn() && uid == me()
        && request.resource.data.keys().hasOnly(['key', 'at'])
        && exists(/databases/$(db)/documents/config/admin)
        && request.resource.data.key == get(/databases/$(db)/documents/config/admin).data.code;
    }

    // Course settings the admin edits in the app: grading rules and extra scenario cards.
    // Evaluators' screens read them; only the course admin can change them.
    match /settings/{doc} {
      allow read: if signedIn();
      allow write: if isAdmin() && doc in ['grading', 'scenarios'];
    }

    match /sessions/{code} {
      allow get: if signedIn();
      allow list: if isAdmin();
      allow create: if signedIn()
        && code.matches('^[A-Z2-9]{6}$')
        && request.resource.data.ownerUid == me()
        && request.resource.data.keys().hasOnly(['ownerUid', 'createdAt', 'updatedAt', 'cohort', 'lessonTopic', 'round', 'participantsUntil'])
        && startAllowed(code);
      allow update: if isStaff(code) && onlyChanged(['round', 'updatedAt', 'participantsUntil']);
      allow delete: if signedIn() && resource.data.ownerUid == me();

      // Proof of the start passcode, written once when a session is created; nobody can read it
      match /proof/{uid} {
        allow create: if signedIn() && uid == me() && request.resource.data.keys().hasOnly(['key']);
      }

      // Evaluator code: readable by evaluators, changed only by the evaluator who started the session
      match /secret/{doc} {
        allow read: if isStaff(code) || isAdmin();
        allow update: if isOwner(code);
        allow create: if signedIn() && ownerAfter(code);
      }

      // Evaluators: the session owner adds themself; anyone else needs the evaluator code.
      // Only the owner can remove an evaluator (evaluators can remove themselves).
      match /staff/{uid} {
        allow read: if isStaff(code) || isAdmin();
        allow delete: if signedIn() && (uid == me() || isOwner(code));
        allow create: if signedIn() && uid == me()
          && request.resource.data.keys().hasOnly(['name', 'joinedAt', 'seenAt', 'pin', 'owner'])
          && request.resource.data.name is string && request.resource.data.name.size() <= 64
          && (ownerAfter(code)
              || request.resource.data.pin == get(/databases/$(db)/documents/sessions/$(code)/secret/pin).data.pin);
        allow update: if signedIn() && uid == me() && onlyChanged(['seenAt', 'name']);
      }

      // Full session state and finished rounds: staff (and read-only for the course admin)
      // The course admin may also write here, to override a round's outcome
      match /engine/{doc} { allow read, write: if isStaff(code) || isAdmin(); }
      match /rounds/{idx} { allow read, write: if isStaff(code) || isAdmin(); }

      // One participant's private cards
      match /views/{uid} {
        allow read: if signedIn() && ((uid == me() && participantsOpen(code)) || isStaff(code) || isAdmin());
        allow write: if isStaff(code);
      }

      // Participant join + "I read it" signals
      match /people/{uid} {
        allow read: if signedIn() && (uid == me() || isStaff(code) || isAdmin());
        allow create: if signedIn() && uid == me() && participantsOpen(code)
          && request.resource.data.keys().hasOnly(['name', 'joinedAt', 'seenAt', 'acks', 'approached'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 64
          && smallMap(request.resource.data.acks) && smallMap(request.resource.data.approached);
        allow update: if signedIn() && uid == me() && participantsOpen(code) && onlyChanged(['name', 'seenAt', 'acks', 'approached'])
          && request.resource.data.name is string
          && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 64
          && smallMap(request.resource.data.acks) && smallMap(request.resource.data.approached);
        allow delete: if signedIn() && (uid == me() || isStaff(code));
      }
    }
  }
}
