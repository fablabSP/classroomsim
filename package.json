{
  "name": "classroomsim",
  "version": "3.8.0",
  "private": true,
  "type": "module",
  "description": "Classroom role-play practice and Lead Trainer assessment. Hosted on GitHub Pages, real-time data on Firebase (free Spark plan).",
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test --test-force-exit tests/logic.test.js tests/engine.test.js tests/scale.test.js",
    "test:rules": "firebase emulators:exec --only firestore \"node --test tests/rules.test.js\"",
    "deploy:rules": "firebase deploy --only firestore:rules"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "esbuild": "^0.24.0",
    "firebase": "^10.14.1",
    "firebase-tools": "^13.35.1",
    "jspdf": "^2.5.2",
    "jspdf-autotable": "^3.8.4"
  }
}
